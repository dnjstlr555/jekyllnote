{
  "name": "jekyllnote",
  "version": "0.1.0",
  "private": true,
  "description": "Local Editor.js-based authoring tool for a Chirpy Jekyll blog. Handles frontmatter, image localization, and safe writes to a git-tracked target folder.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "multer": "^2.2.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dnjstlr555.jekyllnote",
    "productName": "JekyllNote",
    "directories": { "output": "dist-desktop" },
    "asar": false,
    "files": ["electron/**/*", "server/**/*", "public/**/*", "package.json"],
    "mac": { "target": "dmg", "category": "public.app-category.productivity", "icon": "build/icon.png" },
    "win": { "target": "portable", "icon": "build/icon.png" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "build/icon.png" }
  }
}
